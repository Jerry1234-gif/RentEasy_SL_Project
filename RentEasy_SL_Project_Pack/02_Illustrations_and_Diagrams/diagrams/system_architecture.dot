digraph G { graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.5", fontname="DejaVu Sans", label="RentEasy SL — Proposed system architecture", labelloc=t, fontsize=18]; node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, color="#B9CCC2", fillcolor="#F4F8F5", fontcolor="#173447", margin="0.18,0.12"]; edge [color="#57786A", penwidth=1.4, arrowsize=.7, fontname="DejaVu Sans", fontsize=9];
subgraph cluster_client { label="Client layer"; color="#DCE8E1"; style=rounded; browser [label="Responsive web browser\nDesktop / tablet / mobile", fillcolor="#EAF3ED"]; }
subgraph cluster_app { label="Application layer — PHP"; color="#DCE8E1"; style=rounded; routes [label="Laravel routes + middleware"]; controllers [label="Controllers + business rules"]; views [label="Blade views + Bootstrap / CSS / JS"]; services [label="Services: verification, notifications, booking, reports"]; models [label="Eloquent models + validation"]; routes -> controllers; controllers -> services; controllers -> models; controllers -> views; }
subgraph cluster_data { label="Data and file layer"; color="#DCE8E1"; style=rounded; db [label="MySQL database\nUsers, properties, bookings, applications, records", fillcolor="#FFF4E4", color="#E2BE7D"]; files [label="Private file storage\nProperty photos and verification evidence"]; logs [label="Activity logs + backups"]; }
subgraph cluster_ext { label="Optional external services"; color="#DCE8E1"; style=rounded; mail [label="Email / SMS provider"]; maps [label="Maps / geocoding service"]; pay [label="Payment gateway\nFuture phase only"]; }
browser -> routes [label="HTTPS requests"]; views -> browser [label="HTML / assets"]; models -> db [dir=both]; services -> files [dir=both]; services -> logs; services -> mail [style=dashed]; services -> maps [style=dashed]; services -> pay [style=dashed, label="when approved"];
}