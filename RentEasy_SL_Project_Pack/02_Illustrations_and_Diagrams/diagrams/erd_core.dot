digraph G { graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.25", ranksep="0.55", fontname="DejaVu Sans", label="RentEasy SL — Core ERD (conceptual, simplified)", labelloc=t, fontsize=18]; node [shape=record, style=filled, fillcolor="#F6FAF7", color="#9DB8A8", fontname="DejaVu Sans", fontsize=9, fontcolor="#173447", margin="0.08,0.05"]; edge [color="#57786A", penwidth=1.2, arrowsize=.65, fontname="DejaVu Sans", fontsize=8]; users [label="{USERS|PK user_id\lfull_name\lemail (unique)\lphone\lpassword_hash\lrole\lstatus\l}"]; properties [label="{PROPERTIES|PK property_id\lFK owner_user_id\ltitle / description\lproperty_type\lprice / rent_period\lstatus\lverification_status\l}"]; images [label="{PROPERTY_IMAGES|PK image_id\lFK property_id\lfile_path\lis_primary\l}"]; viewings [label="{VIEWING_REQUESTS|PK viewing_id\lFK property_id\lFK tenant_user_id\lrequested_at\lstatus\l}"]; applications [label="{RENTAL_APPLICATIONS|PK application_id\lFK property_id\lFK tenant_user_id\lstatus\lsubmitted_at\l}"]; agreements [label="{RENTAL_AGREEMENTS|PK agreement_id\lFK property_id\lFK tenant_user_id\lstart_date / end_date\lstatus\l}"]; payments [label="{RENT_RECORDS|PK rent_record_id\lFK agreement_id\lamount / due_date\lstatus / method\l}"]; maintenance [label="{MAINTENANCE_REQUESTS|PK request_id\lFK agreement_id\lFK tenant_user_id\lissue / status\l}"]; messages [label="{MESSAGES|PK message_id\lFK sender_user_id\lFK receiver_user_id\lFK property_id (opt)\lbody / created_at\l}"]; reports [label="{USER_REPORTS|PK report_id\lFK reporter_user_id\lFK target_property_id (opt)\lreason / status\l}"]; users -> properties [label="1 to many: owner"]; properties -> images [label="1 to many"]; users -> viewings [label="tenant 1 to many"]; properties -> viewings [label="1 to many"]; users -> applications [label="tenant 1 to many"]; properties -> applications [label="1 to many"]; properties -> agreements [label="1 to many over time"]; users -> agreements [label="tenant 1 to many"]; agreements -> payments [label="1 to many"]; agreements -> maintenance [label="1 to many"]; users -> messages [label="sender / receiver"]; users -> reports [label="reporter"]; properties -> reports [label="target listing"];}