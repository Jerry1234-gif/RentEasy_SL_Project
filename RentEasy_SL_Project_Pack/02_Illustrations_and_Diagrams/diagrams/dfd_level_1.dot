digraph G { graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.65", fontname="DejaVu Sans", label="RentEasy SL — DFD Level 1 (Major processes and data stores)", labelloc=t, fontsize=18]; node [fontname="DejaVu Sans", fontsize=10, color="#AAC2B5", fontcolor="#173447", margin="0.15,0.1"]; edge [color="#57786A", penwidth=1.2, arrowsize=.7, fontname="DejaVu Sans", fontsize=8]; tenant [shape=box, style=filled, fillcolor="#EAF3ED", label="Tenant"]; owner [shape=box, style=filled, fillcolor="#EAF3ED", label="Landlord / Agent"]; admin [shape=box, style=filled, fillcolor="#FFF4E4", label="Administrator"]; p1 [shape=ellipse, style=filled, fillcolor="#DDEDE4", label="1.0\nAccount & Access\nManagement"]; p2 [shape=ellipse, style=filled, fillcolor="#DDEDE4", label="2.0\nProperty Listing\n& Verification"]; p3 [shape=ellipse, style=filled, fillcolor="#DDEDE4", label="3.0\nSearch & Property\nDiscovery"]; p4 [shape=ellipse, style=filled, fillcolor="#DDEDE4", label="4.0\nViewing & Rental\nApplications"]; p5 [shape=ellipse, style=filled, fillcolor="#DDEDE4", label="5.0\nRental Records &\nMaintenance"]; p6 [shape=ellipse, style=filled, fillcolor="#DDEDE4", label="6.0\nMessaging, Alerts\n& Reporting"]; d1 [shape=cylinder, style=filled, fillcolor="#FFF4E4", label="D1 Users & Roles"]; d2 [shape=cylinder, style=filled, fillcolor="#FFF4E4", label="D2 Properties & Media"]; d3 [shape=cylinder, style=filled, fillcolor="#FFF4E4", label="D3 Viewings & Applications"]; d4 [shape=cylinder, style=filled, fillcolor="#FFF4E4", label="D4 Rental, Payment & Maintenance Records"]; d5 [shape=cylinder, style=filled, fillcolor="#FFF4E4", label="D5 Messages, Alerts & Audit Logs"]; tenant -> p1 [label="Registration / login"]; p1 -> d1 [label="Account data"]; owner -> p1 [label="Registration / login"]; tenant -> p3 [label="Search filters"]; p3 -> d2 [label="Read published listings"]; d2 -> p3 [label="Listing details"]; p3 -> tenant [label="Search results"]; owner -> p2 [label="Listing details / evidence"]; p2 -> d2 [label="Save listing and review status"]; admin -> p2 [label="Approve / reject / suspend"]; p2 -> admin [label="Review queue"]; tenant -> p4 [label="Viewing request / application"]; p4 -> d3 [label="Save request"]; d3 -> p4 [label="Request status"]; p4 -> owner [label="New request"]; owner -> p4 [label="Accept / decline / propose time"]; tenant -> p5 [label="Maintenance issue"]; owner -> p5 [label="Rent / maintenance updates"]; p5 -> d4 [label="Rental records / case status"]; p4 -> p6 [label="Status change"]; p5 -> p6 [label="Updates"]; p6 -> d5 [label="Messages / alerts / audit"]; p6 -> tenant [label="Notifications / messages"]; p6 -> owner [label="Notifications / messages"]; admin -> p6 [label="Moderation / reports"]; p6 -> admin [label="Reports / activity summaries"]; }