digraph G { graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.8", fontname="DejaVu Sans", label="RentEasy SL — DFD Level 0 (Context Diagram)", labelloc=t, fontsize=18]; node [fontname="DejaVu Sans", fontsize=11, color="#AAC2B5", fontcolor="#173447", margin="0.18,0.12"]; edge [color="#57786A", penwidth=1.3, arrowsize=.7, fontname="DejaVu Sans", fontsize=9]; tenant [shape=box, style=filled, fillcolor="#EAF3ED", label="Tenant / Property seeker"]; landlord [shape=box, style=filled, fillcolor="#EAF3ED", label="Landlord"]; agent [shape=box, style=filled, fillcolor="#EAF3ED", label="Property agent"]; admin [shape=box, style=filled, fillcolor="#FFF4E4", label="Administrator"]; system [shape=ellipse, style=filled, fillcolor="#DDEDE4", color="#2C7659", penwidth=2, label="0\nRentEasy SL\nProperty Rental & Management System"]; mail [shape=box, style=filled, fillcolor="#F2F5F7", label="Email / SMS service\n(optional)" ]; tenant -> system [label="Search criteria, account details, viewing requests, applications, messages, reports"]; system -> tenant [label="Property results, status updates, messages, reminders"]; landlord -> system [label="Listings, availability, viewing decisions, rent records, maintenance responses"]; system -> landlord [label="Listing status, requests, applications, reports, tenant messages"]; agent -> system [label="Managed listings, booking updates, client enquiries"]; system -> agent [label="Assigned property data, enquiries, task status"]; admin -> system [label="Verification decisions, moderation actions, account controls"]; system -> admin [label="Pending listings, user reports, audit logs, platform reports"]; system -> mail [label="Notification message request"]; mail -> system [label="Delivery status (where supported)"]; }