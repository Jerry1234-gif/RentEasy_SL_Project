digraph G { graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.28", ranksep="0.45", fontname="DejaVu Sans", label="RentEasy SL — Tenant-to-rental workflow", labelloc=t, fontsize=18]; node [shape=box,style="rounded,filled",fillcolor="#EAF3ED",color="#AAC2B5",fontname="DejaVu Sans",fontsize=10,fontcolor="#173447",margin="0.15,0.1"]; edge [color="#57786A",penwidth=1.2,arrowsize=.7,fontname="DejaVu Sans",fontsize=8]; start [label="Tenant creates account\nor continues browsing",fillcolor="#DDEDE4"]; search [label="Search and filter\npublished properties"]; detail [label="Review details, costs,\nphotos and rules"]; save [label="Save property or\nrequest a viewing"]; owner [label="Landlord / agent receives\nviewing request"]; decision [shape=diamond,label="Accept?",fillcolor="#FFF4E4"]; reject [label="Tenant receives decline\nor proposes another time"]; visit [label="Viewing takes place\noff-platform / in person"]; apply [label="Tenant submits\nrental application"]; review [label="Landlord reviews\napplication"]; approved [shape=diamond,label="Approved?",fillcolor="#FFF4E4"]; agreement [label="Parties agree terms;\nagreement recorded"]; rent [label="Rent records and\nmaintenance managed"]; closed [label="Application declined\nor withdrawn",fillcolor="#FBEFED"];
start -> search -> detail -> save -> owner -> decision; decision -> reject [label="No"]; reject -> save; decision -> visit [label="Yes"]; visit -> apply -> review -> approved; approved -> agreement [label="Yes"]; approved -> closed [label="No"]; agreement -> rent; }